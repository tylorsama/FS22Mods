<?xml version="1.0" encoding="utf-8" standalone="no"?>
<placeable type="simplePlaceable">
    <storeData>
        <name>{{PLACEABLE_DISPLAY_NAME}}</name>
        <image>store/{{PLACEABLE_NAME}}.png</image>
        <price>{{PRICE}}</price>
        <lifetime>1200</lifetime>
        <category>placeablesMisc</category>
        <rotation>0</rotation>
    </storeData>

    <base>
        <filename>placeables/{{PLACEABLE_NAME}}.i3d</filename>
    </base>

    <placement>
        <testAreas>
            <testArea startNode="testAreaStart" endNode="testAreaEnd" />
        </testAreas>
    </placement>

    <i3dMappings>
        <i3dMapping id="testAreaStart" node="0>0" />
        <i3dMapping id="testAreaEnd" node="0>1" />
    </i3dMappings>
</placeable>
